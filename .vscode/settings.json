{
  "java.project.importHint": "whenNeeded",
  "files.exclude": {
    "android/": false,
    "ios/": false
  },
  "java.diagnostics.filter": {
    "ignore": ["android/**/*.java"]
  },
  "liveServer.settings.multiRootWorkspaceName": "ERIS-SOSMap",
  "deno.enablePaths": [
    "supabase/functions"
  ],
  "deno.lint": true,
  "deno.unstable": [
    "bare-node-builtins",
    "byonm",
    "sloppy-imports",
    "unsafe-proto",
    "webgpu",
    "broadcast-channel",
    "worker-options",
    "cron",
    "kv",
    "ffi",
    "fs",
    "http",
    "net"
  ],
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  }
}
